<%
    const d = (result && result.data) ? result.data : {};
    const cleanUrl = (u) => (u || '').replace(/https?:\/\/[^\/]+/, '');
    // Perbesar gambar Jetpack (i0.wp.com) agar tajam di kartu besar
    const hi = (u, w) => /i0\.wp\.com/.test(u || '') ? u.replace(/\?.*$/, '') + '?w=' + w : (u || '');
%>

<%
    // Hero: ambil dari "Populer <musim>"; jika kosong, jatuh ke episode terbaru
    const seasonItems = (d.seasonal && d.seasonal.items) ? d.seasonal.items : [];
    const heroFromSeason = seasonItems.filter(a => a.thumbnail).length > 0;
    const heroItems = (heroFromSeason ? seasonItems : (d.catalog || [])).filter(a => a.thumbnail).slice(0, 5);
    const heroBadge = heroFromSeason
        ? ((d.seasonal.title || 'Populer musim ini').toUpperCase())
        : 'NEW EPISODE';
%>

<!-- Hero carousel: Populer musim ini (hanya di Beranda) -->
<% if (d.isHome && heroItems.length > 0) { %>
    <section class="relative mb-2" aria-roledescription="carousel" aria-label="Populer musim ini">
        <div id="heroTrack" class="no-scrollbar flex snap-x snap-mandatory overflow-x-auto rounded-[2rem] shadow-xl shadow-black/15">
            <% heroItems.forEach((it, i) => { %>
                <a href="<%= cleanUrl(it.url) %>" role="group" aria-roledescription="slide" aria-label="<%= i + 1 %> dari <%= heroItems.length %>"
                   class="relative aspect-[16/11] sm:aspect-[21/9] w-full shrink-0 snap-center overflow-hidden bg-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-white">
                    <img src="<%= hi(it.thumbnail, 900) %>" alt="" <%- i === 0 ? '' : 'loading="lazy"' %>
                         onerror="this.onerror=null;this.src='<%= it.thumbnail %>'"
                         class="absolute inset-0 h-full w-full object-cover" style="object-position: 50% 22%;">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/35 to-black/5"></div>
                    <div class="absolute inset-x-5 bottom-5 sm:inset-x-8 sm:bottom-7 pr-16">
                        <span class="inline-block rounded-full bg-sakura px-3 py-1 font-mono text-[11px] font-bold tracking-wider text-white"><%= heroBadge %></span>
                        <h2 class="mt-2 font-display text-4xl sm:text-5xl uppercase leading-[1.02] text-white line-clamp-2"><%= it.title %></h2>
                        <% if (heroFromSeason) { %>
                            <p class="mt-1.5 font-mono text-xs sm:text-sm font-medium text-white/90">#<%= i + 1 %> populer musim ini</p>
                        <% } else if (it.episodeNumber) { %>
                            <p class="mt-1.5 font-mono text-xs sm:text-sm font-medium text-white/90">Episode <%= it.episodeNumber %></p>
                        <% } %>
                    </div>
                </a>
            <% }) %>
        </div>
        <div id="heroDots" class="absolute bottom-6 right-6 flex items-center gap-1.5">
            <% heroItems.forEach((it, i) => { %>
                <button type="button" data-dot="<%= i %>" aria-label="Slide <%= i + 1 %>" class="h-2 rounded-full bg-white/60 transition-all <%= i === 0 ? 'w-6 bg-white' : 'w-2' %>"></button>
            <% }) %>
        </div>
    </section>

    <script>
    (function () {
        var track = document.getElementById('heroTrack');
        var dots = document.querySelectorAll('#heroDots [data-dot]');
        if (!track || dots.length < 2) return;
        var current = 0, timer = null;

        function setDots(i) {
            current = i;
            dots.forEach(function (d, n) {
                d.classList.toggle('w-6', n === i);
                d.classList.toggle('w-2', n !== i);
                d.classList.toggle('bg-white', n === i);
            });
        }
        function go(i) { track.scrollTo({ left: i * track.clientWidth, behavior: 'smooth' }); }
        track.addEventListener('scroll', function () {
            var i = Math.round(track.scrollLeft / track.clientWidth);
            if (i !== current) setDots(i);
        }, { passive: true });
        dots.forEach(function (d, n) { d.addEventListener('click', function () { go(n); }); });

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        function start() { stop(); timer = setInterval(function () { go((current + 1) % dots.length); }, 5000); }
        function stop() { if (timer) clearInterval(timer); timer = null; }
        ['pointerdown', 'focusin', 'mouseenter'].forEach(function (e) { track.addEventListener(e, stop); });
        ['pointerup', 'focusout', 'mouseleave'].forEach(function (e) { track.addEventListener(e, start); });
        start();
    })();
    </script>
<% } %>

<!-- Kolom pencarian (Beranda, hasil pencarian, genre) -->
<form action="/search" method="GET" role="search" class="<%= d.isHome ? 'mt-5' : '' %> mb-8">
    <label for="cari" class="sr-only">Cari anime</label>
    <div class="relative">
        <svg class="absolute left-5 top-1/2 -translate-y-1/2 w-6 h-6 text-brand" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 21l-4.3-4.3M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z"/></svg>
        <input id="cari" type="text" name="q" value="<%= d.searchQuery || '' %>" placeholder="Cari anime favoritmu..."
               class="w-full h-14 rounded-2xl bg-white border border-slate-200 shadow-sm pl-14 pr-4 text-base text-ink placeholder-slate-500 transition focus:outline-none focus:border-brand focus:ring-4 focus:ring-brand/15">
    </div>
</form>

<!-- Lanjut Tonton (diisi dari riwayat di browser) -->
<% if (d.isHome) { %>
    <section id="resumeSection" class="mt-10 mb-10 hidden" aria-labelledby="resume-heading">
        <div class="mb-4 flex items-end justify-between">
            <h2 id="resume-heading" class="font-display text-3xl text-ink">Lanjut Tonton</h2>
            <a href="/library#history" class="font-mono text-xs font-bold tracking-wider text-brand hover:text-brand-dark transition">SEMUA &rarr;</a>
        </div>
        <div id="resumeRow" class="no-scrollbar -mx-4 flex gap-4 overflow-x-auto px-4 pb-2 sm:mx-0 sm:px-0"></div>
    </section>
    <script>
    (function () {
        var list;
        try { list = JSON.parse(localStorage.getItem('anime_history') || '[]'); } catch (e) { list = []; }
        if (!list.length) return;

        function hi(u, w) {
            return /i0\.wp\.com/.test(u || '') ? u.replace(/\?.*$/, '') + '?w=' + w : (u || '');
        }
        function ago(ts) {
            var m = Math.floor((Date.now() - ts) / 60000);
            if (m < 1) return 'baru saja';
            if (m < 60) return m + ' menit lalu';
            var h = Math.floor(m / 60);
            if (h < 24) return h + ' jam lalu';
            return Math.floor(h / 24) + ' hari lalu';
        }

        var row = document.getElementById('resumeRow');
        list.slice(0, 10).forEach(function (it) {
            var a = document.createElement('a');
            a.href = it.url;
            a.className = 'group block w-64 shrink-0 sm:w-72';

            var frame = document.createElement('div');
            frame.className = 'aspect-video overflow-hidden rounded-2xl bg-slate-200 ring-1 ring-slate-900/5 shadow-sm';
            if (it.thumbnail) {
                var img = document.createElement('img');
                img.src = hi(it.thumbnail, 640);
                img.alt = '';
                img.loading = 'lazy';
                img.className = 'h-full w-full object-cover transition-transform duration-300 group-hover:scale-105';
                img.style.objectPosition = '50% 22%';
                img.onerror = function () { img.onerror = null; img.src = it.thumbnail; };
                frame.appendChild(img);
            }

            var title = document.createElement('h3');
            title.className = 'mt-2.5 truncate text-base font-bold text-ink group-hover:text-brand transition-colors';
            title.textContent = it.seriesTitle || it.title;

            var meta = document.createElement('p');
            meta.className = 'mt-0.5 font-mono text-xs text-slate-600';
            meta.textContent = (it.episodeNumber ? 'Ep ' + it.episodeNumber + ' \u2022 ' : '') + ago(it.ts);

            a.appendChild(frame); a.appendChild(title); a.appendChild(meta);
            row.appendChild(a);
        });
        document.getElementById('resumeSection').classList.remove('hidden');
    })();
    </script>
<% } %>

<!-- Genre (hanya di Beranda) -->
<% if (d.isHome && d.genres && d.genres.length > 0) { %>
    <section class="mb-10">
        <div class="flex items-end justify-between mb-4">
            <h2 class="font-display text-xl sm:text-2xl font-extrabold text-ink">Jelajahi genre</h2>
            <a href="/genres" class="text-sm font-semibold text-brand hover:text-brand-dark transition">Lihat semua</a>
        </div>
        <div class="flex flex-wrap gap-2">
            <% d.genres.forEach(genre => { %>
                <a href="<%= cleanUrl(genre.url) %>" class="rounded-full bg-white border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-brand hover:border-brand hover:text-white transition">
                    <%= genre.name %>
                </a>
            <% }) %>
        </div>
    </section>
<% } %>

<!-- Katalog utama (Terbaru / Hasil Pencarian / Kategori / Genre) -->
<section>
    <h2 class="font-display text-xl sm:text-2xl font-extrabold text-ink mb-4">
        <% if (d.searchQuery) { %>
            Hasil pencarian: "<%= d.searchQuery %>"
        <% } else if (d.pageTitle) { %>
            <%= d.pageTitle %>
        <% } else if (d.isHome) { %>
            Update anime terbaru
        <% } else { %>
            Kategori anime
        <% } %>
    </h2>

    <% if (d.catalog && d.catalog.length > 0) { %>

        <% if (d.searchQuery) { %>
            <!-- LIST PENCARIAN -->
            <div class="flex flex-col gap-3">
                <% d.catalog.forEach(anime => { %>
                    <a href="<%= cleanUrl(anime.url) %>" class="group flex gap-4 bg-white rounded-2xl p-3 border border-slate-200 shadow-sm hover:border-brand hover:shadow-md transition">
                        <img src="<%= anime.thumbnail %>" alt="<%= anime.title %>" loading="lazy" class="w-24 h-36 object-cover rounded-xl shrink-0">
                        <div class="flex flex-col justify-between min-w-0 flex-1 py-0.5">
                            <div>
                                <h3 class="text-ink font-bold text-base line-clamp-1 group-hover:text-brand transition-colors"><%= anime.title %></h3>
                                <div class="flex items-center gap-2 text-xs text-slate-600 my-1.5">
                                    <span class="rounded-full bg-sun px-2.5 py-0.5 font-bold text-ink">★ <%= anime.rating || '8.0' %></span>
                                    <span class="rounded-full bg-brand-soft px-2.5 py-0.5 font-semibold text-brand-dark">TV</span>
                                </div>
                                <p class="text-slate-600 text-sm line-clamp-2">
                                    <%= anime.synopsis || 'Klik untuk melihat detail anime ini...' %>
                                </p>
                            </div>
                        </div>
                    </a>
                <% }) %>
            </div>
        <% } else { %>
            <!-- GRID STANDAR (Beranda / Genre / Kategori) -->
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-x-4 gap-y-6">
                <% d.catalog.forEach(anime => { %>
                    <a href="<%= cleanUrl(anime.url) %>" class="group block">
                        <div class="relative overflow-hidden rounded-2xl bg-slate-200 ring-1 ring-slate-900/5 shadow-sm">
                            <img src="<%= anime.thumbnail %>" alt="<%= anime.title %>" loading="lazy" class="aspect-[2/3] w-full object-cover transition-transform duration-300 group-hover:scale-105">
                            <% if (anime.episodeNumber) { %>
                                <span class="absolute bottom-2 left-2 rounded-full bg-sakura px-2.5 py-1 text-xs font-bold text-white"><%= anime.episodeNumber %></span>
                            <% } %>
                        </div>
                        <h3 class="mt-2 text-sm font-semibold text-ink line-clamp-2 group-hover:text-brand transition-colors" title="<%= anime.title %>"><%= anime.title %></h3>
                    </a>
                <% }) %>
            </div>
        <% } %>

        <!-- PAGINASI PENCARIAN -->
        <% if (d.searchQuery) { %>
            <div class="flex justify-between items-center mt-8">
                <% if (d.currentPage > 1) { %>
                    <a href="/search?q=<%= encodeURIComponent(d.searchQuery) %>&page=<%= d.currentPage - 1 %>"
                       class="rounded-full bg-white border border-slate-200 hover:border-brand hover:text-brand text-ink font-bold text-sm px-5 py-2.5 transition">
                        &larr; Sebelumnya
                    </a>
                <% } else { %>
                    <div></div>
                <% } %>

                <span class="text-slate-600 text-sm font-semibold">Halaman <%= d.currentPage %></span>

                <a href="/search?q=<%= encodeURIComponent(d.searchQuery) %>&page=<%= d.currentPage + 1 %>"
                   class="rounded-full bg-brand hover:bg-brand-dark text-white font-bold text-sm px-5 py-2.5 transition">
                    Selanjutnya &rarr;
                </a>
            </div>
        <% } %>

    <% } else { %>
        <!-- KOSONG / HABIS -->
        <div class="bg-white border border-slate-200 rounded-3xl p-10 text-center my-6">
            <p class="text-slate-600 text-sm mb-5">Sudah tidak ada data pada halaman ini.</p>

            <% if (d.searchQuery && d.currentPage > 1) { %>
                <a href="/search?q=<%= encodeURIComponent(d.searchQuery) %>&page=<%= d.currentPage - 1 %>"
                   class="inline-block rounded-full bg-brand hover:bg-brand-dark text-white font-bold text-sm px-5 py-2.5 transition">
                    &larr; Kembali ke halaman <%= d.currentPage - 1 %>
                </a>
            <% } else { %>
                <a href="/" class="inline-block rounded-full bg-brand hover:bg-brand-dark text-white font-bold text-sm px-5 py-2.5 transition">
                    Kembali ke beranda
                </a>
            <% } %>
        </div>
    <% } %>

    <!-- PREV / NEXT (halaman genre) -->
    <% if (d.currentGenre && (d.currentPage > 1 || d.hasNextPage)) { %>
        <nav aria-label="Halaman genre" class="mt-10 flex items-center justify-between pb-4">
            <% if (d.currentPage > 1) { %>
                <a href="/genres/<%= d.currentGenre %>?page=<%= d.currentPage - 1 %>"
                   class="rounded-full border border-slate-300 bg-white px-5 py-2.5 text-sm font-bold text-ink transition hover:border-brand hover:text-brand">&larr; Sebelumnya</a>
            <% } else { %>
                <span></span>
            <% } %>

            <span class="font-mono text-xs font-bold tracking-wider text-slate-600">HALAMAN <%= d.currentPage || 1 %></span>

            <% if (d.hasNextPage) { %>
                <a href="/genres/<%= d.currentGenre %>?page=<%= (d.currentPage || 1) + 1 %>"
                   class="rounded-full bg-brand px-5 py-2.5 text-sm font-bold text-white transition hover:bg-brand-dark">Selanjutnya &rarr;</a>
            <% } else { %>
                <span></span>
            <% } %>
        </nav>
    <% } %>
</section>

<!-- Tab: Series Terbaru / Series Populer / Genre Populer (hanya di Beranda) -->
<% if (d.isHome && d.homeTabs && d.homeTabs.length > 0) { %>
    <%
        const groupLabel = (t) => ({ 'series terbaru': 'Series terbaru', 'popular series': 'Series populer', 'popular genre': 'Genre populer' }[(t || '').toLowerCase()] || t);
        let tabIndex = 0;
    %>
    <section class="mt-12 mb-10" aria-label="Jelajahi series">
        <div class="rounded-3xl bg-brand-soft p-4 sm:p-5">
            <div role="tablist" id="homeTabList" class="flex flex-wrap gap-x-6 gap-y-3 mb-5">
                <% d.homeTabs.forEach(g => { %>
                    <div>
                        <p class="text-[11px] font-bold tracking-wider text-slate-500 uppercase mb-1.5"><%= groupLabel(g.title) %></p>
                        <div class="flex flex-wrap gap-2">
                            <% g.tabs.forEach(t => { %>
                                <% const first = tabIndex === 0; tabIndex++; %>
                                <button type="button" role="tab" id="htab-<%= t.id %>" data-home-tab="<%= t.id %>" aria-controls="hpanel-<%= t.id %>"
                                        aria-selected="<%= first ? 'true' : 'false' %>" tabindex="<%= first ? '0' : '-1' %>"
                                        class="home-tab-btn rounded-full border border-slate-200 bg-white px-4 py-1.5 text-sm font-bold text-slate-700 transition hover:border-brand aria-selected:border-brand aria-selected:bg-brand aria-selected:text-white">
                                    <%= t.label %>
                                </button>
                            <% }) %>
                        </div>
                    </div>
                <% }) %>
            </div>

            <% let panelIndex = 0; %>
            <% d.homeTabs.forEach(g => { g.tabs.forEach(t => { %>
                <% const showFirst = panelIndex === 0; panelIndex++; %>
                <div id="hpanel-<%= t.id %>" role="tabpanel" aria-labelledby="htab-<%= t.id %>" <%- showFirst ? '' : 'hidden' %>>
                    <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 gap-3 sm:gap-4">
                        <% t.items.forEach(item => { %>
                            <a href="<%= cleanUrl(item.url) %>" class="group block">
                                <div class="relative overflow-hidden rounded-2xl bg-slate-200 ring-1 ring-slate-900/5 shadow-sm">
                                    <% if (item.thumbnail) { %>
                                        <img src="<%= item.thumbnail %>" alt="<%= item.title %>" loading="lazy" class="aspect-[2/3] w-full object-cover transition-transform duration-300 group-hover:scale-105">
                                    <% } else { %>
                                        <div class="aspect-[2/3] w-full bg-white"></div>
                                    <% } %>
                                    <% if (item.rating) { %>
                                        <span class="absolute top-2 left-2 rounded-full bg-sun px-2 py-0.5 text-xs font-bold text-ink">★ <%= item.rating %></span>
                                    <% } %>
                                </div>
                                <h3 class="mt-2 text-xs sm:text-sm font-semibold text-ink line-clamp-2 group-hover:text-brand transition-colors"><%= item.title %></h3>
                            </a>
                        <% }) %>
                    </div>
                </div>
            <% }) }) %>
        </div>
    </section>

    <script>
    (function () {
        var tabs = Array.prototype.slice.call(document.querySelectorAll('.home-tab-btn'));
        function select(id) {
            tabs.forEach(function (t) {
                var on = t.dataset.homeTab === id;
                t.setAttribute('aria-selected', on ? 'true' : 'false');
                t.tabIndex = on ? 0 : -1;
                var panel = document.getElementById('hpanel-' + t.dataset.homeTab);
                if (panel) panel.hidden = !on;
            });
        }
        tabs.forEach(function (t, i) {
            t.addEventListener('click', function () { select(t.dataset.homeTab); });
            t.addEventListener('keydown', function (e) {
                var dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
                if (!dir) return;
                var next = tabs[(i + dir + tabs.length) % tabs.length];
                next.focus();
                select(next.dataset.homeTab);
            });
        });
    })();
    </script>
<% } %>

<!-- Top rating (hanya di Beranda) -->
<% if (d.isHome && d.topRated && d.topRated.length > 0) { %>
    <section class="mb-10">
        <h2 class="font-display text-xl sm:text-2xl font-extrabold text-ink mb-4">Top rating anime</h2>
        <ol class="grid grid-cols-1 gap-2 md:grid-cols-2">
            <% d.topRated.forEach((item, idx) => { %>
                <li class="min-w-0">
                    <a href="<%= cleanUrl(item.url) %>" class="group flex items-center justify-between gap-3 rounded-2xl bg-white border border-slate-200 shadow-sm px-4 py-3 hover:border-brand hover:shadow-md transition">
                        <span class="min-w-0 truncate text-sm font-semibold text-ink group-hover:text-brand transition-colors"><%= item.title %></span>
                        <% if (item.rank) { %>
                            <span class="shrink-0 rounded-full bg-brand-soft px-3 py-1 text-xs font-bold text-brand-dark">#<%= item.rank %></span>
                        <% } %>
                    </a>
                </li>
            <% }) %>
        </ol>
    </section>
<% } %>

<!-- Populer musim ini (hanya di Beranda) -->
<% if (d.isHome && d.seasonal && d.seasonal.items && d.seasonal.items.length > 0) { %>
    <section class="mb-10">
        <h2 class="font-display text-xl sm:text-2xl font-extrabold text-ink mb-4"><%= d.seasonal.title || 'Populer musim ini' %></h2>
        <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-3 sm:gap-4">
            <% d.seasonal.items.forEach(item => { %>
                <a href="<%= cleanUrl(item.url) %>" class="group block">
                    <div class="overflow-hidden rounded-2xl bg-slate-200 ring-1 ring-slate-900/5 shadow-sm">
                        <% if (item.thumbnail) { %>
                            <img src="<%= item.thumbnail %>" alt="<%= item.title %>" loading="lazy" class="aspect-[2/3] w-full object-cover transition-transform duration-300 group-hover:scale-105">
                        <% } else { %>
                            <div class="aspect-[2/3] w-full bg-brand-soft"></div>
                        <% } %>
                    </div>
                    <% if (item.title) { %>
                        <h3 class="mt-2 text-xs sm:text-sm font-semibold text-ink line-clamp-2 group-hover:text-brand transition-colors"><%= item.title %></h3>
                    <% } %>
                </a>
            <% }) %>
        </div>
    </section>
<% } %>

