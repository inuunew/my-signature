<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#F3F6F5">
    <title>AnimeID - Streaming Anime Subtitle Indonesia</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                        display: ['Anton', 'Impact', 'system-ui', 'sans-serif'],
                        mono: ['"JetBrains Mono"', 'ui-monospace', 'monospace']
                    },
                    colors: {
                        ink: '#0F1519',
                        paper: '#F3F6F5',
                        brand: { DEFAULT: '#08806B', dark: '#066553', soft: '#DDF4EE' },
                        mint: '#2DD4BF',
                        sakura: { DEFAULT: '#E5482B', soft: '#FFE6E0' },
                        sun: '#FFC933'
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #F3F6F5;
            background-image:
                linear-gradient(rgba(15, 21, 25, .045) 1px, transparent 1px),
                linear-gradient(90deg, rgba(15, 21, 25, .045) 1px, transparent 1px);
            background-size: 26px 26px;
            color: #0F1519;
            overflow-x: clip;
        }
        /* Anton hanya punya satu bobot: cegah faux-bold dari kelas font-extrabold */
        .font-display { font-weight: 400 !important; font-synthesis: none; letter-spacing: .015em; }
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #DDF4EE; }
        ::-webkit-scrollbar-thumb { background: #7CC9BA; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #08806B; }
        .no-scrollbar { scrollbar-width: none; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { transition: none !important; animation: none !important; scroll-behavior: auto !important; }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col font-sans antialiased selection:bg-brand selection:text-white">

    <!-- HEADER -->
    <header class="sticky top-0 z-40 bg-paper/90 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-[72px] flex items-center justify-between">
            <a href="/" class="flex items-center gap-3 rounded-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand">
                <span class="grid place-items-center w-11 h-11 rounded-2xl bg-brand text-white font-display text-2xl leading-none" aria-hidden="true">A</span>
                <span class="font-display text-3xl leading-none text-ink">ANIMEID</span>
            </a>

            <a href="/#cari" aria-label="Cari anime" class="grid place-items-center w-11 h-11 rounded-full bg-white text-brand ring-2 ring-brand/25 hover:ring-brand transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 21l-4.3-4.3M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z"/></svg>
            </a>
        </div>
    </header>

    <!-- KONTEN UTAMA -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-2 pb-36 flex-grow w-full">
        <%- include(body) %>
    </main>

    <!-- FOOTER -->
    <footer class="text-slate-600 text-xs font-mono text-center pb-32 px-4">
        <p>AnimeID &copy; 2026 &middot; Streaming anime subtitle Indonesia</p>
    </footer>

    <!-- NAVIGASI BAWAH: Home, Library, Setting (tengah), Schedule, Genre -->
    <nav aria-label="Navigasi utama" class="fixed inset-x-0 bottom-0 z-50 px-4 pointer-events-none" style="padding-bottom: max(1rem, env(safe-area-inset-bottom));">
        <div class="pointer-events-auto mx-auto max-w-md rounded-[1.75rem] bg-ink/95 backdrop-blur-md shadow-2xl shadow-black/30 grid grid-cols-5 items-end px-2 pt-2.5 pb-2">

            <a href="/" data-nav="/" class="nav-item flex flex-col items-center gap-1 py-1 text-slate-400">
                <svg data-icon class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5L12 4l9 7.5V20a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1v-8.5z"/></svg>
                <span data-label class="font-mono text-[10px] font-bold tracking-wider">HOME</span>
            </a>

            <a href="/library" data-nav="/library" class="nav-item flex flex-col items-center gap-1 py-1 text-slate-400">
                <svg data-icon class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3.5" width="4.2" height="17" rx="1"/><rect x="9.8" y="3.5" width="4.2" height="17" rx="1"/><rect x="15.4" y="4.2" width="4.2" height="16.3" rx="1" transform="rotate(-13 17.5 12.3)"/></svg>
                <span data-label class="font-mono text-[10px] font-bold tracking-wider">LIBRARY</span>
            </a>

            <a href="/settings" data-nav="/settings" class="nav-item flex flex-col items-center gap-1 -mt-9 text-slate-400">
                <span data-fab class="grid place-items-center w-14 h-14 rounded-2xl bg-brand text-white shadow-lg shadow-brand/40 ring-4 ring-paper transition">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/></svg>
                </span>
                <span data-label class="font-mono text-[10px] font-bold tracking-wider">SETTING</span>
            </a>

            <a href="/schedule" data-nav="/schedule" class="nav-item flex flex-col items-center gap-1 py-1 text-slate-400">
                <svg data-icon class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M8 3v4M16 3v4M3.5 10h17"/></svg>
                <span data-label class="font-mono text-[10px] font-bold tracking-wider">SCHEDULE</span>
            </a>

            <a href="/genres" data-nav="/genres" class="nav-item flex flex-col items-center gap-1 py-1 text-slate-400">
                <svg data-icon class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="7" height="7" rx="1.6"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.6"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.6"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.6"/></svg>
                <span data-label class="font-mono text-[10px] font-bold tracking-wider">GENRE</span>
            </a>

        </div>
    </nav>

    <script>
        (function () {
            // Tandai menu aktif
            var path = window.location.pathname.replace(/\/+$/, '') || '/';
            document.querySelectorAll('[data-nav]').forEach(function (a) {
                var href = a.getAttribute('data-nav');
                var active = href === '/' ? path === '/' : path.indexOf(href) === 0;
                if (!active) return;
                a.setAttribute('aria-current', 'page');
                a.classList.remove('text-slate-400');
                a.classList.add('text-white');
                var icon = a.querySelector('[data-icon]');
                if (icon) icon.classList.add('text-mint');
                var fab = a.querySelector('[data-fab]');
                if (fab) { fab.classList.remove('ring-paper'); fab.classList.add('ring-mint'); }
            });

            // Tombol cari di header: fokuskan kolom pencarian
            if (window.location.hash === '#cari') {
                var input = document.getElementById('cari');
                if (input) input.focus();
            }
        })();
    </script>

</body>
</html>
